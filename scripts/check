#!/bin/sh
# Full check of the library: unit tests (:testing on its fixture tree, :unlock with Robolectric at the
# Billing SDK boundary, :permissions its policy and flow plus Robolectric at the Activity Result
# boundary, :unlock-ui and :permissions-ui their guardrails), lint, release builds.
set -eu
cd "$(dirname "$0")/.."
./gradlew --quiet :testing:test :unlock:testDebugUnitTest :unlock:lintDebug :unlock:assembleRelease \
  :unlock-ui:testDebugUnitTest :unlock-ui:lintDebug :unlock-ui:assembleRelease \
  :permissions:testDebugUnitTest :permissions:lintDebug :permissions:assembleRelease \
  :permissions-ui:testDebugUnitTest :permissions-ui:lintDebug :permissions-ui:assembleRelease
